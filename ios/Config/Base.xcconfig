// Base configuration referenced by project.yml. project.yml bridges these
// three settings into Info.plist, where PhoenixConfig.swift reads them.
//
// All three default to empty, which means:
//   API_KEY empty    -> offline echo mode (no network, no key needed)
//   ENDPOINT empty   -> chosen automatically from the key's provider
//                       (sk-... => OpenAI, otherwise => Gemini)
//   MODEL empty      -> that provider's default model
// Set ENDPOINT/MODEL only to override the automatic choice (proxy, Azure,
// a self-hosted OpenAI-compatible server, a specific model, ...).
//
// Nothing here is a secret.
PHOENIX_LLM_API_KEY =
PHOENIX_LLM_ENDPOINT =
PHOENIX_LLM_MODEL =

// Then the optional, gitignored secrets file. `#include?` does not error when
// the file is missing (fresh checkout, CI). It comes LAST on purpose:
// xcconfig assignments are last-wins, so anything defined there overrides the
// defaults above. Putting the include first would let the defaults silently
// clobber a real key.
#include? "Secrets.xcconfig"
