// TEMPLATE — copy to ios/Config/Secrets.xcconfig and fill in to enable the
// live assistant. Secrets.xcconfig is gitignored; this template is not a
// secret. The app also accepts a key pasted into the Debug tab at runtime,
// which needs no rebuild.
//
// Only the key is required. The provider is detected from it:
//   sk-...                  -> OpenAI       (gpt-4o-mini)
//   AIza... / AQ... / other -> Gemini       (gemini-flash-latest)
//
// Do NOT commit a real key.

PHOENIX_LLM_API_KEY = paste-your-key-here

// Optional overrides. Leave blank to use the provider defaults above.
// The `$()` is an empty expansion that stops `//` starting a comment.
// PHOENIX_LLM_ENDPOINT = https:/$()/generativelanguage.googleapis.com/v1beta/openai/chat/completions
// PHOENIX_LLM_MODEL = gemini-flash-latest
