// TEMPLATE — copy to ios/Config/Secrets.xcconfig and fill in to enable the
// live LLM assistant. Secrets.xcconfig is gitignored; this template is not a
// secret. Base.xcconfig includes Secrets.xcconfig optionally, so the app
// builds and runs (in offline echo mode) with no key configured.
//
// Do NOT commit a real key. URLs: the empty expansion `$()` keeps `//` from
// starting an xcconfig comment.

PHOENIX_LLM_API_KEY = sk-your-key-here
PHOENIX_LLM_ENDPOINT = https:/$()/api.openai.com/v1/chat/completions
PHOENIX_LLM_MODEL = gpt-4o-mini
